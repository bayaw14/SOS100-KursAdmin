@model List<SOS100_KursAdmin_MVC.Models.Course>

@{
    ViewData["Title"] = "Kursutbud";
}

@if (ViewBag.Error != null)
{
    <div style="color: red; font-weight: bold; margin-bottom: 20px;">
        @ViewBag.Error
    </div>
}

<div class="courses-topbar">
    <h1>Kursutbud</h1>
    <a asp-controller="Courses" asp-action="Create" class="courses-create-btn">+ Skapa kurs</a>
</div>

<div class="courses-grid">
    @if (Model != null && Model.Any())
    {
        @foreach (var course in Model)
        {
            <div class="courses-card">
                <span class="courses-code">@course.CourseCode</span>
                <h3>@course.Title</h3>
                <p>@course.Description</p>
                <div class="courses-meta">Lärare @course.TeacherName</div>
            </div>
        }
    }
    else
    {
        <div class="courses-card">
            <h3>Inga kurser ännu</h3>
            <p>Det finns inga kurser att visa just nu.</p>
        </div>
    }
</div>