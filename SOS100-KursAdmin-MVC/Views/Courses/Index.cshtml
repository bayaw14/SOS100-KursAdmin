@model List<SOS100_KursAdmin_MVC.Models.Course>

@{
    ViewData["Title"] = "Kursutbud";
}

@section Styles {
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
}

<div class="courses-header">
    <h2>Kursutbud</h2>

    @if (Context.Session.GetString("UserRole") == "Admin")
    {
        <a asp-controller="Courses"
           asp-action="Create"
           class="create-course-btn">
            + Skapa kurs
        </a>
    }
</div>

@if (ViewBag.Error != null)
{
    <div style="color:red; margin-bottom:20px;">
        @ViewBag.Error
    </div>
}

@if (Model == null || !Model.Any())
{
    <p>Inga kurser finns ännu.</p>
}
else
{
    <div class="courses-grid">
        @foreach (var course in Model)
        {
            <div class="course-card">
                <span class="course-code">@course.CourseCode</span>
                <h3>@course.Title</h3>
                <p>@course.Description</p>

                <div class="course-meta">
                    Lärare: @course.TeacherName <br />
                    Poäng: @course.Credits
                </div>

                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <div class="course-actions">
                        <a asp-action="Edit"
                           asp-route-id="@course.Id"
                           class="course-action-btn">
                            Redigera
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@course.Id"
                              method="post"
                              style="display:inline;">
                            <button type="submit" class="course-delete-btn">
                                Ta bort
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}