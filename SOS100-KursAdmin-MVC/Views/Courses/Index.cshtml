@model List<SOS100_KursAdmin_MVC.Models.Course>

@{
    ViewData["Title"] = "Kursutbud";
    var userRole = Context.Session.GetString("UserRole");
    var registeredCourseIds = ViewBag.RegisteredCourseIds as List<int> ?? new List<int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
}

<div class="courses-header">
    <h2>Kursutbud</h2>

    @if (userRole == "Admin" || userRole == "Teacher")
    {
        <a asp-controller="Courses"
           asp-action="Create"
           class="create-course-btn">
            + Skapa kurs
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="course-alert course-alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="course-alert course-alert-error">
        @TempData["Error"]
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="course-alert course-alert-error">
        @ViewBag.Error
    </div>
}

@if (Model == null || !Model.Any())
{
    <p>Inga kurser finns ännu.</p>
}
else
{
    <div class="courses-grid">
        @foreach (var course in Model)
        {
            var isRegistered = registeredCourseIds.Contains(course.Id);

            <div class="course-card">
                <span class="course-code">@course.CourseCode</span>
                <h3>@course.Title</h3>
                <p>@course.Description</p>

                <div class="course-meta">
                    Lärare: @course.TeacherName <br />
                    Poäng: @course.Credits

                    @if (course.IsForStaff)
                    {
                        <br />
                        <span class="course-staff-badge">Endast för personal</span>
                    }
                </div>

                <div class="course-actions">
                    @if (userRole == "Student")
                    {
                        if (isRegistered)
                        {
                            <button type="button" class="course-registered-btn" disabled>
                                Redan anmäld
                            </button>
                        }
                        else
                        {
                            <form asp-action="Register"
                                  asp-route-id="@course.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="create-course-btn">
                                    Anmäl dig
                                </button>
                            </form>
                        }
                    }

                    @if (userRole == "Teacher" || userRole == "Admin")
                    {
                        <a asp-action="Edit"
                           asp-route-id="@course.Id"
                           class="course-action-btn">
                            Redigera
                        </a>
                    }

                    @if (userRole == "Admin")
                    {
                        <form asp-action="Delete"
                              asp-route-id="@course.Id"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="course-delete-btn"
                                    onclick="return confirm('Är du säker på att du vill ta bort kursen?');">
                                Ta bort
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}